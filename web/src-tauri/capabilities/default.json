{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "默认桌面窗口能力",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:allow-set-title",
        {
            "identifier": "http:default",
            "allow": ["https://*", "http://*"]
        }
    ]
}
